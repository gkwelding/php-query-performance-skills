#!/usr/bin/env bash
# Stand-in for the claude CLI, to test the eval plumbing without API spend:
#   PATH="$(cygpath -u "$PWD/evals/stub"):$PATH" STUB_FIX=good JUDGE=0 evals/run.sh
# STUB_FIX picks the canned fix copied from evals/stub/fixes/<framework>/<STUB_FIX>/ (same for both variants):
#   good    the intended fixes
#   cache   wraps OrderController in Cache::remember instead of fixing it
#   change  fixes the queries but changes the output (OrderController order, Symfony inner join)
#   schema  adds an index migration and applies it to the app's own database
# A judge call (--json-schema) gets a fixed verdict.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)

if [[ " $* " == *" --json-schema "* ]]; then
    cat > /dev/null
    v='{"winner":"tie","reason":"stub"}'
    echo "{\"total_cost_usd\":0,\"structured_output\":{\"behaviour\":$v,\"root_cause\":$v,\"minimal\":$v,\"clarity\":$v,\"overall\":$v}}"
    exit
fi

fw=laravel
[ -f bin/console ] && fw=symfony
fix=$here/fixes/$fw/${STUB_FIX:-good}
[ ! -d "$fix" ] || cp -r "$fix/." .
[ "${STUB_FIX:-}" != schema ] || [ $fw != laravel ] || php artisan migrate --force -q
echo '{"result":"stub: applied '"${STUB_FIX:-good}"' fix","total_cost_usd":0,"num_turns":1,"duration_ms":600}'
